{
	"name": "pi-voice-realtime",
	"version": "0.1.0-alpha.2",
	"description": "/voice para o pi: conversa por voz full-duplex (OpenAI Realtime), no desenho do /voice do Codex CLI. Alpha, Linux-only.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/IgorGuariroba/pi-voice-realtime.git"
	},
	"homepage": "https://github.com/IgorGuariroba/pi-voice-realtime#readme",
	"bugs": {
		"url": "https://github.com/IgorGuariroba/pi-voice-realtime/issues"
	},
	"engines": {
		"node": ">=22.6"
	},
	"scripts": {
		"test": "node --test --experimental-strip-types tests/*.test.ts",
		"test:unit": "node --test --experimental-strip-types $(ls tests/*.test.ts | grep -v integration)"
	},
	"keywords": [
		"pi-package",
		"pi",
		"voice",
		"realtime",
		"openai",
		"speech"
	],
	"license": "MIT",
	"private": false,
	"type": "module",
	"os": [
		"linux"
	],
	"files": [
		"*.ts",
		"README.md",
		"LICENSE",
		"GLOSSARY.md",
		"prompts/**",
		"docs/**"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"image": "https://raw.githubusercontent.com/IgorGuariroba/pi-voice-realtime/main/docs/media/preview.png",
		"video": "https://raw.githubusercontent.com/IgorGuariroba/pi-voice-realtime/main/docs/media/demo.mp4"
	},
	"dependencies": {
		"ws": "^8.18.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*",
		"@earendil-works/pi-agent-core": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-agent-core": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	}
}

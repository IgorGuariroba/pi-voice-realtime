[
  { "name": "session.created", "raw": { "type": "session.created" }, "expect": { "kind": "ready" } },
  { "name": "audio delta GA com item", "raw": { "type": "response.output_audio.delta", "item_id": "item_1", "delta": "AAAAAA==" }, "expect": { "kind": "audio", "pcmBase64": "AAAAAA==", "itemId": "item_1" } },
  { "name": "user transcript", "raw": { "type": "conversation.item.input_audio_transcription.completed", "transcript": "roda os testes do pacote" }, "expect": { "kind": "user_transcript", "text": "roda os testes do pacote" } },
  { "name": "assistant transcript delta", "raw": { "type": "response.output_audio_transcript.delta", "delta": "Já estou" }, "expect": { "kind": "assistant_transcript", "text": "Já estou", "final": false } },
  { "name": "assistant transcript done", "raw": { "type": "response.output_audio_transcript.done", "transcript": "Já estou olhando." }, "expect": { "kind": "assistant_transcript", "text": "Já estou olhando.", "final": true } },
  { "name": "speech started (barge-in)", "raw": { "type": "input_audio_buffer.speech_started" }, "expect": { "kind": "speech_started" } },
  { "name": "speech stopped", "raw": { "type": "input_audio_buffer.speech_stopped" }, "expect": { "kind": "speech_stopped" } },
  { "name": "response done", "raw": { "type": "response.done" }, "expect": { "kind": "response_done" } },
  { "name": "background_agent com pedido", "raw": { "type": "response.function_call_arguments.done", "name": "background_agent", "call_id": "call_abc", "arguments": "{\"prompt\":\"rode os testes do pacote voice\"}" }, "expect": { "kind": "background_agent", "callId": "call_abc", "prompt": "rode os testes do pacote voice" } },
  { "name": "remain_silent", "raw": { "type": "response.function_call_arguments.done", "name": "remain_silent", "call_id": "call_s", "arguments": "{}" }, "expect": { "kind": "remain_silent", "callId": "call_s" } },
  { "name": "outra função é ignorada", "raw": { "type": "response.function_call_arguments.done", "name": "outra", "call_id": "x", "arguments": "{}" }, "expect": { "kind": "other", "type": "response.function_call_arguments.done" } },
  { "name": "background_agent sem pedido é erro", "raw": { "type": "response.function_call_arguments.done", "name": "background_agent", "call_id": "c", "arguments": "{\"prompt\":\"  \"}" }, "expect": { "kind": "error" } },
  { "name": "api error", "raw": { "type": "error", "error": { "message": "invalid model" } }, "expect": { "kind": "error", "message": "invalid model" } },
  { "name": "unknown event", "raw": { "type": "rate_limits.updated" }, "expect": { "kind": "other", "type": "rate_limits.updated" } }
]
